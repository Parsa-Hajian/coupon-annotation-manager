# Copy this file to secrets.toml for local dev, or paste into
# Streamlit Cloud > App Settings > Secrets for cloud deployment.

# --- Google Cloud service account (from mykey.json) ---
[gcp_service_account]
type = "service_account"
project_id = "adroit-arcana-480911-k1"
private_key_id = "YOUR_PRIVATE_KEY_ID"
private_key = "-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"
client_email = "YOUR_SERVICE_ACCOUNT_EMAIL"
client_id = "YOUR_CLIENT_ID"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "YOUR_CERT_URL"
universe_domain = "googleapis.com"

# --- Turso database (free at https://turso.tech) ---
[turso]
url = "libsql://YOUR-DB-NAME.turso.io"
token = "YOUR_TURSO_AUTH_TOKEN"
